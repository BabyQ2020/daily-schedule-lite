{
  "name": "daily-schedule-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Daily Schedule Lite V1.0：左侧日程 + 右侧长期任务的本地优先轻量工作台（纯前端 PWA）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "vite preview --port 4180 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "isolation:check": "node scripts/check-isolation.mjs",
    "isolation:baseline": "node scripts/check-isolation.mjs --write",
    "icons": "node scripts/generate-icons.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:offline": "node scripts/offline-check.mjs",
    "verify:rescue": "node scripts/verify-rescue.mjs",
    "package": "node packaging/build-portable.mjs --server dotnet",
    "package:node": "node packaging/build-portable.mjs --server node",
    "package:full": "npm run build && node packaging/build-portable.mjs --server dotnet"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
